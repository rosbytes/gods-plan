{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**", "bundle.cjs*", "index.js"]
        },
        "build:app": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**", "bundle.cjs*", "index.js"]
        },
        "prod:build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**", "bundle.cjs*", "index.js"]
        },
        "lint": {
            "dependsOn": []
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    },
    "globalEnv": [
        "NODE_ENV",
        "SERVER_PORT",
        "FRONTEND_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "ADMIN_JWT_ACCESS_TOKEN_SECRET",
        "ADMIN_JWT_REFRESH_TOKEN_SECRET",
        "ADMIN_JWT_ACCESS_TOKEN_EXPIRY",
        "ADMIN_JWT_REFRESH_TOKEN_EXPIRY",
        "MARKET_JWT_ACCESS_TOKEN_SECRET",
        "MARKET_JWT_REFRESH_TOKEN_SECRET",
        "MARKET_JWT_ACCESS_TOKEN_EXPIRY",
        "MARKET_JWT_REFRESH_TOKEN_EXPIRY",
        "JWT_ACCESS_TOKEN_EXPIRY",
        "JWT_REFRESH_TOKEN_EXPIRY",
        "JWT_ACCESS_TOKEN_SECRET",
        "JWT_REFRESH_TOKEN_SECRET",
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "RAZORPAY_KEY_ID",
        "RAZORPAY_KEY_SECRET",
        "AWS_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_S3_BUCKET_NAME",
        "MSG91_AUTH_KEY",
        "VITE_MSG91_WIDGET_ID",
        "VITE_MSG91_TOKEN_AUTH"
    ]
}
