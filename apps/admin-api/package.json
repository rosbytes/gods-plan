{
    "name": "@ros/admin-api",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "build": "tsup && (if [ \"$VERCEL\" = \"1\" ]; then rm -rf src; fi)",
        "start": "node dist/app.mjs",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ros/commons": "workspace:*",
        "cloudinary": "^2.9.0",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.45.1",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "libphonenumber-js": "^1.12.40",
        "multer": "^2.1.1",
        "postgres": "^3.4.8",
        "razorpay": "^2.9.6",
        "redis": "^5.11.0",
        "tsdown": "^0.22.3",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "winston": "^3.19.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@trpc/server": "^11.14.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.5.0",
        "@types/jsonwebtoken": "^9.0.10",
        "drizzle-kit": "^0.31.10",
        "tsc-alias": "^1.8.16"
    }
}
