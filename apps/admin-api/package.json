{
    "name": "@ros/admin-api",
    "main": "api/index.js",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "pnpm typecheck && tsup",
        "dev:build": "tsc -b && tsc-alias -f",
        "prod:build": "turbo run build",
        "start": "node api/index.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1092.0",
        "@ros/commons": "workspace:*",
        "@ros/db": "workspace:*",
        "@trpc/server": "^11.14.1",
        "cookie": "^2.0.1",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "libphonenumber-js": "^1.12.40",
        "multer": "^2.1.1",
        "postgres": "^3.4.8",
        "razorpay": "^2.9.8",
        "redis": "^5.11.0",
        "tsc-alias": "^1.8.16",
        "tsup": "^8.5.1",
        "winston": "^3.19.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^26.2.0",
        "@vercel/config": "^0.6.0",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3"
    }
}
