{
    "name": "@ros/test-api",
    "main": "api/index.js",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "build": "pnpm typecheck && tsup",
        "dev:build": "tsc -b && tsc-alias -f",
        "prod:build": "turbo run build",
        "start": "node dist/app.cjs",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1092.0",
        "@trpc/server": "^11.14.1",
        "@ros/commons": "workspace:*",
        "@ros/db": "workspace:*",
        "cookie": "^2.0.1",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "libphonenumber-js": "^1.12.40",
        "multer": "^2.1.1",
        "postgres": "^3.4.8",
        "razorpay": "^2.9.6",
        "redis": "^5.11.0",
        "tsdown": "^0.22.3",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "winston": "^3.19.0",
        "zod": "^4.3.6",
        "tsc-alias": "^1.8.16"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.5.0"
