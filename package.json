{
    "name": "ros",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "prepare": "husky",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.1",
        "turbo": "latest",
        "prettier-plugin-tailwindcss": "^0.7.2"
    },
    "packageManager": "pnpm@9.0.0",
    "pnpm": {
        "overrides": {
            "esbuild": "0.25.12"
        }
    }
}
