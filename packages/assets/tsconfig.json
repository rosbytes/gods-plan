{
    "compilerOptions": {
        "module": "esnext",
        "target": "esnext",
        "types": ["node"],
        "moduleResolution": "bundler",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "strict": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    },
    "include": ["src"]
}
