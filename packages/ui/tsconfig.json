{
    "compilerOptions": {
        "module": "esnext",
        "target": "esnext",
        "lib": ["dom", "dom.iterable", "esnext"],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "strict": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": ["src", "dev"]
}
