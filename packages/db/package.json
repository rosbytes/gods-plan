{
    "name": "@ros/db",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "dev": "echo 'Add dev script here'",
        "build": "pnpm typecheck && tsdown",
        "test": "echo 'Add test script here'",
        "lint": "echo 'Add lint script here'",
        "typecheck": "tsc --noEmit",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f",
        "seed": "tsx --env-file=.env ./seed.ts",
        "reset": "tsx --env-file=.env ./reset-db.ts && drizzle-kit push --config drizzle-dev.config.ts --force && pnpm seed",
        "drop": "drizzle-kit drop --config drizzle-dev.config.ts",
        "push": "drizzle-kit push --config drizzle-dev.config.ts",
        "pull": "drizzle-kit pull --config drizzle-dev.config.ts",
        "export": "drizzle-kit export --config=drizzle-dev.config.ts",
        "studio": "drizzle-kit studio --verbose --config drizzle-dev.config.ts",
        "up": "drizzle-kit up --config drizzle-dev.config.ts",
        "migrate": "drizzle-kit migrate --config drizzle-dev.config.ts",
        "generate": "drizzle-kit generate --config drizzle-dev.config.ts",
        "prod:up": "drizzle-kit up --config drizzle-prod.config.ts",
        "prod:migrate": "drizzle-kit migrate --config drizzle-prod.config.ts",
        "prod:generate": "drizzle-kit generate --config drizzle-prod.config.ts"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "postgres": "^3.4.9",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "bcryptjs": "^3.0.3",
        "drizzle-kit": "^0.31.10",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3"
    }
}
